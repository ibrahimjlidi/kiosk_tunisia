import mongoose from 'mongoose';
import dotenv from 'dotenv';

import { User } from '../models/User';
import { Station } from '../models/Station';
import { Pump } from '../models/Pump';
import { Product } from '../models/Product';
import { Tank } from '../models/Tank';
import { Shift } from '../models/Shift';
import { Customer } from '../models/Customer';
import { Supplier } from '../models/Supplier';
import { Expense } from '../models/Expense';
import { ProductPurchase } from '../models/ProductPurchase';
import { PurchaseOrder } from '../models/PurchaseOrder';
import { TankGauging } from '../models/TankGauging';
import { KifReturn } from '../models/KifReturn';
import { DailyClosure } from '../models/DailyClosure';
import { Sale } from '../models/Sale';
import { CreditTransaction } from '../models/CreditTransaction';

dotenv.config();

const toDate = (value: string) => new Date(value);
const roundCurrency = (value: number) => Number(value.toFixed(2));

async function seed() {
  try {
    await mongoose.connect(process.env.MONGO_URI!);
    console.log('MongoDB connected');

    await Promise.all([
      User.deleteMany({}),
      Station.deleteMany({}),
      Pump.deleteMany({}),
      Product.deleteMany({}),
      Tank.deleteMany({}),
      Shift.deleteMany({}),
      Customer.deleteMany({}),
      Supplier.deleteMany({}),
      Expense.deleteMany({}),
      ProductPurchase.deleteMany({}),
      PurchaseOrder.deleteMany({}),
      TankGauging.deleteMany({}),
      KifReturn.deleteMany({}),
      DailyClosure.deleteMany({}),
      Sale.deleteMany({}),
      CreditTransaction.deleteMany({}),
    ]);

    const stationSeeds = [
      { name: 'Station Kiosque Les Berges', code: 'STN-001', address: 'Avenue de la République, Tunis', city: 'Tunis', phone: '71234567', taxId: '123456789TUN' },
      { name: 'Station El Mourouj', code: 'STN-002', address: 'Rue de la Liberté, El Mourouj', city: 'Ariana', phone: '71010101', taxId: '223456789TUN' },
      { name: 'Station Sousse Centre', code: 'STN-003', address: 'Avenue Habib Bourguiba, Sousse', city: 'Sousse', phone: '72020202', taxId: '323456789TUN' },
      { name: 'Station Monastir', code: 'STN-004', address: 'Route de Monastir, Monastir', city: 'Monastir', phone: '73030303', taxId: '423456789TUN' },
      { name: 'Station Sfax Port', code: 'STN-005', address: 'Port de Sfax, Sfax', city: 'Sfax', phone: '74040404', taxId: '523456789TUN' },
    ];

    const stations = await Station.insertMany(stationSeeds.map((station) => ({ ...station, active: true })));

    const products = await Product.insertMany([
      { name: 'Gasoil 2.200', code: 'GO2200', category: 'FUEL', purchasePrice: 2.1, sellingPrice: 2.5, vatRate: 19, unitOfMeasure: 'LITER', minStockAlert: 1000, currentStock: 0, active: true },
      { name: 'Sans Plomb 95', code: 'SP95', category: 'FUEL', purchasePrice: 2.35, sellingPrice: 2.9, vatRate: 19, unitOfMeasure: 'LITER', minStockAlert: 1000, currentStock: 0, active: true },
      { name: 'Gasoil 50', code: 'GO50', category: 'FUEL', purchasePrice: 2.25, sellingPrice: 2.7, vatRate: 19, unitOfMeasure: 'LITER', minStockAlert: 1000, currentStock: 0, active: true },
      { name: 'Eau 1.5L', code: 'WATER15', category: 'KIOSK', purchasePrice: 0.8, sellingPrice: 1.5, vatRate: 19, unitOfMeasure: 'UNIT', minStockAlert: 50, currentStock: 120, active: true },
      { name: 'Service Lavage', code: 'WASH01', category: 'SERVICE', purchasePrice: 0, sellingPrice: 8, vatRate: 0, unitOfMeasure: 'SERVICE', minStockAlert: 0, currentStock: 0, active: true },
      { name: 'Huile Moteur 5W30', code: 'OIL530', category: 'KIOSK', purchasePrice: 8.5, sellingPrice: 12.5, vatRate: 19, unitOfMeasure: 'UNIT', minStockAlert: 20, currentStock: 40, active: true },
      { name: 'Pneumatique Air', code: 'AIR01', category: 'SERVICE', purchasePrice: 0, sellingPrice: 1.5, vatRate: 0, unitOfMeasure: 'SERVICE', minStockAlert: 0, currentStock: 0, active: true },
    ]);

    const [gasoil, super95, gasoil50] = products;

    const users = await User.create([
      { username: 'admin', email: 'admin@fuelstation.tn', password: 'Admin@123', role: 'ADMIN', firstName: 'System', lastName: 'Administrator', phone: '71000000', active: true, station: stations[0]._id },
      { username: 'manager', email: 'manager@fuelstation.tn', password: 'Manager@123', role: 'MANAGER', firstName: 'Nabil', lastName: 'Hammami', phone: '71111111', active: true, station: stations[0]._id },
      { username: 'supervisor', email: 'supervisor@fuelstation.tn', password: 'Supervisor@123', role: 'SUPERVISOR', firstName: 'Salma', lastName: 'Ben Ali', phone: '71222222', active: true, station: stations[0]._id },
      { username: 'operator', email: 'operator@fuelstation.tn', password: 'Operator@123', role: 'OPERATOR', firstName: 'Hedi', lastName: 'Mansour', phone: '71333333', active: true, station: stations[0]._id },
      { username: 'manager2', email: 'manager2@fuelstation.tn', password: 'Manager@123', role: 'MANAGER', firstName: 'Lotfi', lastName: 'Jemni', phone: '71555555', active: true, station: stations[1]._id },
      { username: 'supervisor2', email: 'supervisor2@fuelstation.tn', password: 'Supervisor@123', role: 'SUPERVISOR', firstName: 'Mourad', lastName: 'Khaled', phone: '71666666', active: true, station: stations[1]._id },
      { username: 'manager3', email: 'manager3@fuelstation.tn', password: 'Manager@123', role: 'MANAGER', firstName: 'Rania', lastName: 'Zidi', phone: '71777777', active: true, station: stations[2]._id },
      { username: 'manager4', email: 'manager4@fuelstation.tn', password: 'Manager@123', role: 'MANAGER', firstName: 'Amine', lastName: 'Bouraoui', phone: '71888888', active: true, station: stations[3]._id },
      { username: 'manager5', email: 'manager5@fuelstation.tn', password: 'Manager@123', role: 'MANAGER', firstName: 'Sarra', lastName: 'Mekni', phone: '71999999', active: true, station: stations[4]._id },
    ]);

    const adminUser = users[0];
    const stationManagers = users.filter((user) => user.role === 'MANAGER');
    await Promise.all(stations.map((station, index) => Station.findByIdAndUpdate(station._id, { manager: stationManagers[index % stationManagers.length]._id })));

    const suppliers = await Supplier.insertMany([
      { name: 'PetroTunisie', code: 'PT-001', contactPerson: 'Karim', phone: '71010101', email: 'sales@petrotunisie.tn', address: 'Tunis', taxId: '11111111' },
      { name: 'Fuel Supply Co.', code: 'FSC-002', contactPerson: 'Hajer', phone: '71020202', email: 'ops@fuelsupply.tn', address: 'Sfax', taxId: '22222222' },
      { name: 'GreenFuel', code: 'GF-003', contactPerson: 'Sami', phone: '75050505', email: 'ops@greenfuel.tn', address: 'Bizerte', taxId: '33333333' },
      { name: 'AutoLub', code: 'AL-004', contactPerson: 'Nadia', phone: '76060606', email: 'sales@autolub.tn', address: 'Nabeul', taxId: '44444444' },
    ]);

    const customers = await Customer.insertMany([
      { name: 'Ahmed Ben Youssef', phone: '70010001', email: 'ahmed@example.com', address: 'Tunis', creditBalance: 150 },
      { name: 'Fatma Trabelsi', phone: '70010002', email: 'fatma@example.com', address: 'Ariana', creditBalance: 80 },
      { name: 'Mohamed Sassi', phone: '70010003', email: 'mohamed@example.com', address: 'Sousse', creditBalance: 0 },
      { name: 'Noura Khaled', phone: '70010004', email: 'noura@example.com', address: 'Monastir', creditBalance: 45 },
      { name: 'Yassine Bouzid', phone: '70010005', email: 'yassine@example.com', address: 'Sfax', creditBalance: 25 },
      { name: 'Meriem Dridi', phone: '70010006', email: 'meriem@example.com', address: 'Bizerta', creditBalance: 60 },
      { name: 'Kamel Jaziri', phone: '70010007', email: 'kamel@example.com', address: 'Gabes', creditBalance: 35 },
    ]);

    for (let index = 0; index < stations.length; index += 1) {
      const station = stations[index];
      const stationUser = users.find((user) => user.station?.toString() === station._id.toString() && user.role !== 'ADMIN') || users[1];
      const pumpSeed = [
        { pumpNumber: `PUMP-${index + 1}-A`, product: gasoil._id, secondProduct: super95._id },
        { pumpNumber: `PUMP-${index + 1}-B`, product: gasoil50._id, secondProduct: super95._id },
      ];

      const createdPumps = await Pump.insertMany(pumpSeed.map((pump, pumpIndex) => ({
        station: station._id,
        pumpNumber: pump.pumpNumber,
        active: true,
        pistols: [
          { pistolNumber: 1, product: pump.product, currentClosingIndex: 1100 + index * 50 + pumpIndex * 10, active: true },
          { pistolNumber: 2, product: pump.secondProduct, currentClosingIndex: 900 + index * 40 + pumpIndex * 10, active: true },
        ],
      })));

      const createdTanks = await Tank.insertMany([
        { station: station._id, product: gasoil._id, tankNumber: `TANK-${index + 1}-A`, capacity: 20000, currentStock: 14000 + index * 300, minLevelAlert: 2000, active: true },
        { station: station._id, product: super95._id, tankNumber: `TANK-${index + 1}-B`, capacity: 18000, currentStock: 12000 + index * 250, minLevelAlert: 2200, active: true },
        { station: station._id, product: gasoil50._id, tankNumber: `TANK-${index + 1}-C`, capacity: 17000, currentStock: 9000 + index * 200, minLevelAlert: 1800, active: true },
      ]);

      const purchaseRows = [
        { product: gasoil._id, station: station._id, supplier: suppliers[index % suppliers.length].name, quantity: 5000 + index * 500, unitCost: 2.05 + index * 0.01, totalCost: roundCurrency((5000 + index * 500) * (2.05 + index * 0.01)), notes: `Fuel delivery ${station.name}` },
        { product: super95._id, station: station._id, supplier: suppliers[(index + 1) % suppliers.length].name, quantity: 4000 + index * 300, unitCost: 2.3 + index * 0.01, totalCost: roundCurrency((4000 + index * 300) * (2.3 + index * 0.01)), notes: `Fuel delivery ${station.name}` },
        { product: gasoil50._id, station: station._id, supplier: suppliers[(index + 2) % suppliers.length].name, quantity: 3000 + index * 200, unitCost: 2.2 + index * 0.01, totalCost: roundCurrency((3000 + index * 200) * (2.2 + index * 0.01)), notes: `Fuel delivery ${station.name}` },
      ];
      await ProductPurchase.insertMany(purchaseRows);

      await PurchaseOrder.create({
        supplier: suppliers[index % suppliers.length]._id,
        station: station._id,
        orderNumber: `PO-${1000 + index + 1}`,
        orderDate: toDate(`2026-08-0${index + 1}T08:00:00.000Z`),
        status: 'DELIVERED',
        items: [{ product: gasoil._id, quantity: 1800 + index * 100, unitPrice: 2.08 + index * 0.01, totalPrice: roundCurrency((1800 + index * 100) * (2.08 + index * 0.01)), tank: createdTanks[0]._id }],
        totalAmount: roundCurrency((1800 + index * 100) * (2.08 + index * 0.01)),
        notes: `Delivery for ${station.name}`,
        createdBy: adminUser._id,
        deliveredBy: stationUser?.firstName || 'Supervisor',
      });

      await PurchaseOrder.create({
        supplier: suppliers[(index + 1) % suppliers.length]._id,
        station: station._id,
        orderNumber: `PO-${2000 + index + 1}`,
        orderDate: toDate(`2026-08-0${index + 2}T09:00:00.000Z`),
        status: 'PENDING',
        items: [{ product: super95._id, quantity: 1200 + index * 80, unitPrice: 2.35 + index * 0.01, totalPrice: roundCurrency((1200 + index * 80) * (2.35 + index * 0.01)), tank: createdTanks[1]._id }],
        totalAmount: roundCurrency((1200 + index * 80) * (2.35 + index * 0.01)),
        notes: `Supplementary order ${station.name}`,
        createdBy: adminUser._id,
        deliveredBy: stationUser?.firstName || 'Supervisor',
      });

      await Expense.insertMany([
        { station: station._id, type: 'OPERATING', description: 'Cleaning supplies', amount: 80 + index * 15, paid: true, notes: `Daily operating cost ${station.name}` },
        { station: station._id, type: 'MAINTENANCE', description: 'Pump maintenance', amount: 180 + index * 20, paid: true, notes: `Maintenance visit ${station.name}` },
        { station: station._id, type: 'UTILITY', description: 'Electricity', amount: 120 + index * 10, paid: true, notes: `Utility bill ${station.name}` },
        { station: station._id, type: 'KIOSK', description: 'Stock replenishment', amount: 60 + index * 8, paid: true, notes: `Kiosk restock ${station.name}` },
      ]);

      const morningShift = await Shift.create({
        station: station._id,
        shiftType: index % 2 === 0 ? 'MORNING' : 'AFTERNOON',
        shiftDate: toDate('2026-08-01T00:00:00.000Z'),
        shiftNumber: 1,
        status: 'CLOSED',
        openedBy: stationUser?._id || adminUser._id,
        closedBy: stationUser?._id || adminUser._id,
        employees: [stationUser?._id || adminUser._id],
        pumpReadings: createdPumps.map((pump, pumpIndex) => ({
          pump: pump._id,
          pumpNumber: pump.pumpNumber,
          pistolReadings: pump.pistols.map((pistol, pistolIndex) => ({
            pistolId: pistol._id,
            pistolNumber: pistol.pistolNumber ?? pistolIndex + 1,
            product: pistol.product,
            productName: (pistol.product.toString() === gasoil._id.toString() ? gasoil.name : super95.name),
            productCode: (pistol.product.toString() === gasoil._id.toString() ? gasoil.code : super95.code),
            purchasePrice: (pistol.product.toString() === gasoil._id.toString() ? gasoil.purchasePrice : super95.purchasePrice),
            sellingPrice: (pistol.product.toString() === gasoil._id.toString() ? gasoil.sellingPrice : super95.sellingPrice),
            vatRate: (pistol.product.toString() === gasoil._id.toString() ? gasoil.vatRate : super95.vatRate),
            openingIndex: 1100 + index * 30 + pumpIndex * 20 + pistolIndex * 5,
            closingIndex: 1180 + index * 40 + pumpIndex * 20 + pistolIndex * 5,
            volumeSold: 60 + index * 5 + pumpIndex * 3 + pistolIndex,
            amountHT: roundCurrency((60 + index * 5 + pumpIndex * 3 + pistolIndex) * (pistol.product.toString() === gasoil._id.toString() ? gasoil.sellingPrice : super95.sellingPrice) / 1.19),
            vatAmount: roundCurrency((60 + index * 5 + pumpIndex * 3 + pistolIndex) * (pistol.product.toString() === gasoil._id.toString() ? gasoil.sellingPrice : super95.sellingPrice) / 1.19 * 0.19),
            amountTTC: roundCurrency((60 + index * 5 + pumpIndex * 3 + pistolIndex) * (pistol.product.toString() === gasoil._id.toString() ? gasoil.sellingPrice : super95.sellingPrice)),
            profit: roundCurrency((60 + index * 5 + pumpIndex * 3 + pistolIndex) * ((pistol.product.toString() === gasoil._id.toString() ? gasoil.sellingPrice : super95.sellingPrice) - (pistol.product.toString() === gasoil._id.toString() ? gasoil.purchasePrice : super95.purchasePrice))),
          })) })),
        totalVolumeByProduct: [
          { product: gasoil._id, productName: gasoil.name, volumeSold: 100 + index * 10 },
          { product: super95._id, productName: super95.name, volumeSold: 80 + index * 8 },
        ],
        totalSalesHT: roundCurrency(120 + index * 20),
        totalVAT: roundCurrency(24 + index * 4),
        totalSalesTTC: roundCurrency(144 + index * 24),
        totalProfit: roundCurrency(40 + index * 10),
        cashAmount: roundCurrency(90 + index * 10),
        bankCardAmount: roundCurrency(20 + index * 3),
        fuelCardAmount: roundCurrency(10 + index * 2),
        bankTransferAmount: 5,
        creditAmount: roundCurrency(15 + index),
        totalPayments: roundCurrency(144 + index * 24),
        balance: 0,
        isBalanced: true,
        totalExpenses: 0,
        openedAt: toDate('2026-08-01T06:00:00.000Z'),
        closedAt: toDate('2026-08-01T14:00:00.000Z'),
        notes: `Shift seeded for ${station.name}`,
      });

      const afternoonShift = await Shift.create({
        station: station._id,
        shiftType: index % 2 === 0 ? 'AFTERNOON' : 'MORNING',
        shiftDate: toDate('2026-08-02T00:00:00.000Z'),
        shiftNumber: 2,
        status: 'OPEN',
        openedBy: stationUser?._id || adminUser._id,
        employees: [stationUser?._id || adminUser._id],
        pumpReadings: createdPumps.map((pump, pumpIndex) => ({
          pump: pump._id,
          pumpNumber: pump.pumpNumber,
          pistolReadings: pump.pistols.map((pistol, pistolIndex) => ({
            pistolId: pistol._id,
            pistolNumber: pistol.pistolNumber ?? pistolIndex + 1,
            product: pistol.product,
            productName: (pistol.product.toString() === gasoil._id.toString() ? gasoil.name : super95.name),
            productCode: (pistol.product.toString() === gasoil._id.toString() ? gasoil.code : super95.code),
            purchasePrice: (pistol.product.toString() === gasoil._id.toString() ? gasoil.purchasePrice : super95.purchasePrice),
            sellingPrice: (pistol.product.toString() === gasoil._id.toString() ? gasoil.sellingPrice : super95.sellingPrice),
            vatRate: (pistol.product.toString() === gasoil._id.toString() ? gasoil.vatRate : super95.vatRate),
            openingIndex: 1180 + index * 30 + pumpIndex * 20 + pistolIndex * 5,
            closingIndex: 1180 + index * 30 + pumpIndex * 20 + pistolIndex * 5,
            volumeSold: 0,
            amountHT: 0,
            vatAmount: 0,
            amountTTC: 0,
            profit: 0,
          })) })),
        totalVolumeByProduct: [],
        totalSalesHT: 0,
        totalVAT: 0,
        totalSalesTTC: 0,
        totalProfit: 0,
        cashAmount: 0,
        bankCardAmount: 0,
        fuelCardAmount: 0,
        bankTransferAmount: 0,
        creditAmount: 0,
        totalPayments: 0,
        balance: 0,
        isBalanced: true,
        totalExpenses: 0,
        openedAt: toDate('2026-08-02T06:00:00.000Z'),
        notes: `Second shift seeded for ${station.name}`,
      });

      await Sale.insertMany([
        {
          station: station._id,
          shift: morningShift._id,
          pump: createdPumps[0]._id,
          pistol: createdPumps[0].pistols[0]._id,
          product: gasoil._id,
          productName: gasoil.name,
          productCode: gasoil.code,
          employee: stationUser?._id || adminUser._id,
          quantity: 80 + index * 5,
          purchasePrice: gasoil.purchasePrice,
          sellingPrice: gasoil.sellingPrice,
          vatRate: gasoil.vatRate,
          amountHT: roundCurrency(64 + index * 4),
          vatAmount: roundCurrency(12.16 + index * 0.8),
          amountTTC: roundCurrency(76.16 + index * 4.8),
          profit: roundCurrency(32 + index * 2),
          paymentMethod: 'CASH',
        },
        {
          station: station._id,
          shift: morningShift._id,
          pump: createdPumps[0]._id,
          pistol: createdPumps[0].pistols[1]._id,
          product: super95._id,
          productName: super95.name,
          productCode: super95.code,
          employee: stationUser?._id || adminUser._id,
          quantity: 60 + index * 4,
          purchasePrice: super95.purchasePrice,
          sellingPrice: super95.sellingPrice,
          vatRate: super95.vatRate,
          amountHT: roundCurrency(51 + index * 3),
          vatAmount: roundCurrency(9.69 + index * 0.6),
          amountTTC: roundCurrency(60.69 + index * 3.6),
          profit: roundCurrency(39 + index * 2),
          paymentMethod: 'BANK_CARD',
        },
        {
          station: station._id,
          shift: afternoonShift._id,
          pump: createdPumps[1]._id,
          pistol: createdPumps[1].pistols[0]._id,
          product: gasoil50._id,
          productName: gasoil50.name,
          productCode: gasoil50.code,
          employee: stationUser?._id || adminUser._id,
          quantity: 50 + index * 3,
          purchasePrice: gasoil50.purchasePrice,
          sellingPrice: gasoil50.sellingPrice,
          vatRate: gasoil50.vatRate,
          amountHT: roundCurrency(40 + index * 2.4),
          vatAmount: roundCurrency(7.6 + index * 0.45),
          amountTTC: roundCurrency(47.6 + index * 2.85),
          profit: roundCurrency(20 + index * 1.5),
          paymentMethod: 'FUEL_CARD',
        },
        {
          station: station._id,
          shift: afternoonShift._id,
          pump: createdPumps[1]._id,
          pistol: createdPumps[1].pistols[1]._id,
          product: super95._id,
          productName: super95.name,
          productCode: super95.code,
          employee: stationUser?._id || adminUser._id,
          quantity: 35 + index * 2,
          purchasePrice: super95.purchasePrice,
          sellingPrice: super95.sellingPrice,
          vatRate: super95.vatRate,
          amountHT: roundCurrency(30 + index * 1.8),
          vatAmount: roundCurrency(5.7 + index * 0.34),
          amountTTC: roundCurrency(35.7 + index * 2.14),
          profit: roundCurrency(15 + index * 1.1),
          paymentMethod: 'BANK_TRANSFER',
        },
      ]);

      await TankGauging.insertMany([
        {
          tank: createdTanks[0]._id,
          station: station._id,
          gaugedAt: toDate('2026-08-01T12:00:00.000Z'),
          dipReading: 380 + index * 10,
          calculatedVolume: 14500 + index * 200,
          waterLevel: 10 + index,
          temperature: 24 + index,
          theoreticalStock: 14000 + index * 300,
          variance: 100 + index * 20,
          operator: stationUser?._id || adminUser._id,
          notes: `Gauging ${station.name}`,
        },
        {
          tank: createdTanks[1]._id,
          station: station._id,
          gaugedAt: toDate('2026-08-02T12:00:00.000Z'),
          dipReading: 360 + index * 8,
          calculatedVolume: 13800 + index * 180,
          waterLevel: 8 + index,
          temperature: 23 + index,
          theoreticalStock: 12000 + index * 250,
          variance: 90 + index * 15,
          operator: stationUser?._id || adminUser._id,
          notes: `Second gauging ${station.name}`,
        },
      ]);

      await KifReturn.insertMany([
        {
          station: station._id,
          shift: morningShift._id,
          date: toDate('2026-08-01T10:30:00.000Z'),
          product: gasoil._id,
          quantity: 10 + index,
          reason: 'Verification test',
          notes: `Kif return ${station.name}`,
          operator: stationUser?._id || adminUser._id,
        },
        {
          station: station._id,
          shift: afternoonShift._id,
          date: toDate('2026-08-02T10:30:00.000Z'),
          product: super95._id,
          quantity: 6 + index,
          reason: 'Operational return',
          notes: `Second Kif return ${station.name}`,
          operator: stationUser?._id || adminUser._id,
        },
      ]);

      await DailyClosure.insertMany([
        {
          station: station._id,
          closureDate: toDate('2026-08-01T00:00:00.000Z'),
          status: 'CLOSED',
          salesTTC: roundCurrency(144 + index * 24),
          totalPayments: roundCurrency(144 + index * 24),
          totalExpenses: roundCurrency(260 + index * 20),
          totalPurchases: roundCurrency(9000 + index * 300),
          totalKifQuantity: 10 + index,
          variance: 0,
          isBalanced: true,
          notes: `Seeded close for ${station.name}`,
          closedBy: stationUser?._id || adminUser._id,
          closedAt: toDate('2026-08-01T15:00:00.000Z'),
        },
        {
          station: station._id,
          closureDate: toDate('2026-08-02T00:00:00.000Z'),
          status: 'CLOSED',
          salesTTC: roundCurrency(160 + index * 28),
          totalPayments: roundCurrency(160 + index * 28),
          totalExpenses: roundCurrency(275 + index * 22),
          totalPurchases: roundCurrency(9600 + index * 320),
          totalKifQuantity: 12 + index,
          variance: 0,
          isBalanced: true,
          notes: `Second seeded close for ${station.name}`,
          closedBy: stationUser?._id || adminUser._id,
          closedAt: toDate('2026-08-02T15:00:00.000Z'),
        },
      ]);

      await CreditTransaction.insertMany([
        { customer: customers[index % customers.length]._id, station: station._id, type: 'SALE', amount: 100 + index * 15, notes: `Credit for ${station.name}` },
        { customer: customers[(index + 2) % customers.length]._id, station: station._id, type: 'PAYMENT', amount: -40 - index * 2, notes: `Payment for ${station.name}` },
      ]);
    }

    console.log('Seed data created successfully');
    process.exit(0);
  } catch (error: any) {
    console.error(error);
    process.exit(1);
  }
}

seed();
